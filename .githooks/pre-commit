#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ -x ".venv/bin/python" ]; then
  PYTHON=".venv/bin/python"
else
  PYTHON="python3"
fi

if command -v ruff >/dev/null 2>&1; then
  RUFF="ruff"
elif [ -x ".venv/bin/ruff" ]; then
  RUFF=".venv/bin/ruff"
else
  echo "ruff is required for the pre-commit lint hook." >&2
  echo "Install it with: $PYTHON -m pip install ruff" >&2
  exit 1
fi

echo "Running Python compile check..."
"$PYTHON" -m compileall custom_components/virtual_layer tests -q

echo "Running Ruff syntax lint..."
"$RUFF" check custom_components/virtual_layer tests --select E9,F63,F7,F82

echo "Checking whitespace..."
git diff --check

